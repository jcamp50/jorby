# Only @jorby/* is private. Public packages stay on the default npm registry so
# `npm ci` keeps working before FOUNDRY_TOKEN exists. The Foundry-generated
# .npmrc at the repo root uses Foundry as the default registry; do not copy
# that default into this app or every install requires a token.
@jorby:registry=https://jordca.usw-22.palantirfoundry.com/artifacts/api/repositories/ri.stemma.main.repository.6a5d351e-04de-4a12-b380-1b8c2893e20e/contents/release/npm/
//jordca.usw-22.palantirfoundry.com/artifacts/api/:_authToken=${FOUNDRY_TOKEN}
omit-lockfile-registry-resolved=true
